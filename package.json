{
  "name": "tranfr",
  "version": "1.0.0",
  "description": "Programmable recovery for CKB self-custody — a lock script that lets an owner keep full control of their assets while active, and lets a designated recovery recipient claim them if the owner goes inactive for a defined period. No custodian, no oracle, no protocol changes.",
  "type": "module",
  "main": "./sdk/dist/index.js",
  "types": "./sdk/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/dist/index.d.ts",
      "import": "./sdk/dist/index.js"
    }
  },
  "files": [
    "sdk/dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:contract": "make build CONTRACT=tranfr-lock",
    "test:contract": "cargo test",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test:sdk": "tsx --test sdk/tests/*.test.ts",
    "test:all": "cargo test && tsx --test sdk/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "generate-key": "tsx scripts/deploy.ts --generate-key",
    "deploy": "tsx scripts/deploy.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ckb-ccc/core": "^1.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
